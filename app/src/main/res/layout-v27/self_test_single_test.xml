<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/guidelineMid"
        app:layout_constraintGuide_percent="0.35" />

    <View
        android:id="@+id/view1"
        android:layout_width="@dimen/_1sdp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/guidelineMid"
        app:layout_constraintEnd_toEndOf="@id/guidelineMid"
        android:background="@color/black"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/guidelineMidLast"
        app:layout_constraintGuide_percent="0.65" />

    <View
        android:id="@+id/view2"
        android:layout_width="@dimen/_1sdp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/guidelineMidLast"
        app:layout_constraintEnd_toEndOf="@id/guidelineMidLast"
        android:background="@color/black"/>

    <View
        android:id="@+id/viewH1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/black"/>

    <TextView
        android:id="@+id/itemTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_4sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_5sdp"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineMid"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/itemTitleHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_4sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_6sdp"
        android:fontFamily="@font/arial_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineMid"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/itemStatus"
        android:layout_width="@dimen/_6sdp"
        android:layout_height="@dimen/_6sdp"
        android:layout_gravity="center"
        android:src="@drawable/ic_red_cross"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/itemTitle"
        app:layout_constraintStart_toEndOf="@id/guidelineMid"
        app:layout_constraintEnd_toStartOf="@id/guidelineMidLast"
        app:layout_constraintTop_toTopOf="@id/itemTitle" />

    <TextView
        android:id="@+id/itemStatusHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_4sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_6sdp"
        android:visibility="visible"
        android:fontFamily="@font/arial_bold"
        app:layout_constraintBottom_toBottomOf="@id/itemTitle"
        app:layout_constraintStart_toEndOf="@id/guidelineMid"
        app:layout_constraintEnd_toStartOf="@id/guidelineMidLast"
        app:layout_constraintTop_toTopOf="@id/itemTitle" />


    <TextView
        android:id="@+id/itemValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_4sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_5sdp"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineMidLast"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/itemValueHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/_4sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_6sdp"
        android:fontFamily="@font/arial_bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guidelineMidLast"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>