<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".system.wifi.WiFiFragment">

    <TextView
        android:id="@+id/txtStoragePermission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        android:textSize="@dimen/_7sdp"
        android:text="Storage PERMISSION"
        android:textAllCaps="true"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_25sdp"
        android:layout_marginStart="@dimen/_10sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.github.angads25.toggle.widget.LabeledSwitch
        android:id="@+id/toggle_storage_permission"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_15sdp"
        android:visibility="visible"
        android:textSize="@dimen/_7sdp"
        app:colorBorder="@color/grey"
        app:colorOff="@color/white"
        app:colorOn="@color/light_grey"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtStoragePermission"
        app:layout_constraintBottom_toBottomOf="@id/txtStoragePermission"
        app:on="false" />

    <TextView
        android:id="@+id/txtLocationPermissions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        android:textSize="@dimen/_7sdp"
        android:text="Location PERMISSION"
        android:textAllCaps="true"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginStart="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@id/txtStoragePermission"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.github.angads25.toggle.widget.LabeledSwitch
        android:id="@+id/toggle_location_permission"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_15sdp"
        android:visibility="visible"
        android:textSize="@dimen/_9sdp"
        app:colorBorder="@color/grey"
        app:colorOff="@color/white"
        app:colorOn="@color/light_grey"
        android:layout_marginEnd="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtLocationPermissions"
        app:layout_constraintBottom_toBottomOf="@id/txtLocationPermissions"
        app:on="false" />

    <TextView
        android:id="@+id/txtWifi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        android:textSize="@dimen/_7sdp"
        android:text="WiFi Status"
        android:textAllCaps="true"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginStart="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@id/txtLocationPermissions"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.github.angads25.toggle.widget.LabeledSwitch
        android:id="@+id/toggle_wifi"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_15sdp"
        android:visibility="visible"
        android:textSize="@dimen/_9sdp"
        app:colorBorder="@color/grey"
        app:colorOff="@color/white"
        app:colorOn="@color/light_grey"
        android:layout_marginEnd="@dimen/_10sdp"
        android:tooltipText="@string/service_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtWifi"
        app:layout_constraintBottom_toBottomOf="@id/txtWifi"
        app:on="false" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/connectionStatusLayout"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        android:background="@drawable/rounded_drawables"
        app:layout_constraintTop_toBottomOf="@id/txtWifi"
        app:layout_constraintStart_toStartOf="@id/txtLocationPermissions"
        app:layout_constraintEnd_toEndOf="@id/toggle_wifi"
        app:layout_constraintBottom_toTopOf="@id/txtNote">

        <TextView
            android:id="@+id/txtConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/avenir_next_lt_pro_medium"
            android:textSize="@dimen/_12sdp"
            android:text="CONNECTED"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/txtIpAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/avenir_next_lt_pro_medium"
            android:textSize="@dimen/_7sdp"
            android:text=""
            android:textAllCaps="true"
            android:textColor="@color/preCalib_amber"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@id/txtConnectionStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/avenir_next_lt_pro_bold"
        android:textSize="@dimen/_4sdp"
        android:text=""
        android:textColor="@color/black"
        android:layout_marginBottom="@dimen/_5sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/connectionStatusLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/txtWifi"/>

</androidx.constraintlayout.widget.ConstraintLayout>