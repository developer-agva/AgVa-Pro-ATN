<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="@dimen/_80sdp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/cross_img"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
            android:src="@drawable/ic_cross_black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/txtMessage"/>


        <TextView
            android:id="@+id/txtMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/string_for_info_reset"
            android:textColor="@color/black"
            android:textSize="21dp"
            android:layout_marginTop="@dimen/_5sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cross_img"/>




        <EditText
            android:id="@+id/etOtp1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_13sdp"
            android:hint="*"
            android:digits="0123456789"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:paddingHorizontal="@dimen/_5sdp"
            android:background="@null"
            android:textColor="@color/black"
            android:inputType="phone"
            android:maxLength="1"
            app:layout_constraintStart_toStartOf="@id/txtMessage"
            app:layout_constraintTop_toBottomOf="@id/txtMessage"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <View
            android:id="@+id/view1"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/black"
            app:layout_constraintStart_toStartOf="@id/etOtp1"
            app:layout_constraintEnd_toEndOf="@id/etOtp1"
            app:layout_constraintTop_toBottomOf="@id/etOtp1"/>


        <EditText
            android:id="@+id/etOtp2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_13sdp"
            android:hint="*"
            android:digits="0123456789"
            android:paddingHorizontal="@dimen/_5sdp"
            android:background="@null"
            android:textColor="@color/black"
            android:inputType="phone"
            android:maxLength="1"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_7sdp"
            app:layout_constraintStart_toEndOf="@id/etOtp1"
            app:layout_constraintEnd_toStartOf="@id/etOtp3"
            app:layout_constraintTop_toTopOf="@id/etOtp1"
            app:layout_constraintBottom_toBottomOf="@id/etOtp1"/>

        <View
            android:id="@+id/view2"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/black"
            app:layout_constraintStart_toStartOf="@id/etOtp2"
            app:layout_constraintEnd_toEndOf="@id/etOtp2"
            app:layout_constraintTop_toTopOf="@id/view1"
            app:layout_constraintBottom_toBottomOf="@id/view1"/>



        <EditText
            android:id="@+id/etOtp3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_13sdp"
            android:hint="*"
            android:digits="0123456789"
            android:paddingHorizontal="@dimen/_5sdp"
            android:background="@null"
            android:textColor="@color/black"
            android:inputType="phone"
            android:maxLength="1"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@id/etOtp2"
            app:layout_constraintEnd_toStartOf="@id/etOtp4"
            app:layout_constraintBottom_toBottomOf="@id/etOtp1"
            app:layout_constraintTop_toTopOf="@id/etOtp1"/>

        <View
            android:id="@+id/view3"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/black"
            app:layout_constraintStart_toStartOf="@id/etOtp3"
            app:layout_constraintEnd_toEndOf="@id/etOtp3"
            app:layout_constraintTop_toTopOf="@id/view1"
            app:layout_constraintBottom_toBottomOf="@id/view1"/>


        <EditText
            android:id="@+id/etOtp4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_13sdp"
            android:hint="*"
            android:digits="0123456789"
            android:paddingHorizontal="@dimen/_5sdp"
            android:background="@null"
            android:textColor="@color/black"
            android:inputType="phone"
            android:maxLength="1"
            android:imeOptions="actionDone"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="@id/etOtp1"
            app:layout_constraintEnd_toEndOf="@id/txtMessage"
            app:layout_constraintBottom_toBottomOf="@id/etOtp1"/>

        <View
            android:id="@+id/view4"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/black"
            app:layout_constraintStart_toStartOf="@id/etOtp4"
            app:layout_constraintEnd_toEndOf="@id/etOtp4"
            app:layout_constraintTop_toTopOf="@id/view1"
            app:layout_constraintBottom_toBottomOf="@id/view1"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>