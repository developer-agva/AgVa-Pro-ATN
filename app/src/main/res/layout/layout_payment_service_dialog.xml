<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="40dp"
    app:cardBackgroundColor="@color/light_black"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/ack_red">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp"
                android:text="VENTIlator De-Activated"
                android:textAllCaps="true"
                android:visibility="visible"
                android:textColor="@android:color/white"
                android:textSize="25dp"
                android:textStyle="normal" />

        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!--Main Layout-->
            <LinearLayout
                android:id="@+id/layoutMain"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/deviceIdText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:lineSpacingExtra="4dp"
                        android:padding="10dp"
                        android:textStyle="normal"
                        android:textAllCaps="true"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:text=""
                        android:textColor="@android:color/white"
                        android:textSize="20dp" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/support_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:lineSpacingExtra="4dp"
                        android:padding="10dp"
                        android:textStyle="normal"
                        android:textAllCaps="true"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:text="Contact customer care "
                        android:textColor="@android:color/white"
                        android:textSize="20dp" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/support_textPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:lineSpacingExtra="4dp"
                        android:padding="10dp"
                        android:textStyle="normal"
                        android:textAllCaps="true"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:text="Phone - +91 73 30 40 50 60"
                        android:textColor="@android:color/white"
                        android:textSize="20dp" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/support_textEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:lineSpacingExtra="4dp"
                        android:padding="10dp"
                        android:textStyle="normal"
                        android:textAllCaps="true"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:text="Email - support@agvahealthtech.com"
                        android:textColor="@android:color/white"
                        android:textSize="20dp" />


                </LinearLayout>




                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:columnCount="2"
                    android:visibility="gone"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCancel"
                        android:layout_columnWeight="1"
                        android:background="@drawable/style_bordered_btn_white"
                        android:text="Cancel"
                        android:textColor="@android:color/white" />

                    <!--                    <androidx.appcompat.widget.AppCompatButton-->
                    <!--                        android:id="@+id/btnStandby"-->
                    <!--                        android:layout_columnWeight="1"-->
                    <!--                        android:background="@color/white"-->
                    <!--                        android:text="Standby"-->
                    <!--                        android:textColor="@color/black" />-->

                </GridLayout>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>