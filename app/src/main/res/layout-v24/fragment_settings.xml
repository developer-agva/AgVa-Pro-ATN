<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainViewPanelSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_grey">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/focusLayoutSettings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/background_transparent_border_yellow"
        android:translationZ="@dimen/_1sdp"
        tools:ignore="MissingConstraints" />


    <include
        android:id="@+id/includeButtonLoudness"
        layout="@layout/content_button_layout"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/includeButtonChange"
        layout="@layout/content_button_layout"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/includeButtonLoudness" />

    <include
        android:id="@+id/includeColorChange"
        layout="@layout/content_button_layout"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/includeButtonChange" />


    <!--Loudness View-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPanelLoudness"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_5sdp"
        android:background="@drawable/background_grey_border_white"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/includeButtonLoudness"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/focusLayoutLoudness"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/background_transparent_border_yellow"
            android:translationZ="@dimen/_1sdp"
            tools:ignore="MissingConstraints" />

        <include
            android:id="@+id/progressBarLoudness"
            layout="@layout/knob_progress_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_40sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewLoudness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/hint_loudness"
            android:theme="@style/subheading_text_style"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressBarLoudness" />

        <include
            android:id="@+id/includeButtonTest"
            layout="@layout/content_button_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewLoudness" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--Tube Compensation View-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPanelTubeComp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/_5sdp"
        android:background="@drawable/background_grey_border_white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/includeButtonLoudness"
        app:layout_constraintTop_toTopOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/switchLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_30sdp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/focusLayoutSwitch"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/background_transparent_border_yellow"
                android:translationZ="@dimen/_1sdp"
                tools:ignore="MissingConstraints" />

            <TextView
                android:id="@+id/useText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Knob Dialog"
                android:theme="@style/subheading_text_style"
                app:layout_constraintBottom_toBottomOf="@+id/toggle_knob"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/toggle_knob" />

            <com.github.angads25.toggle.widget.LabeledSwitch
                android:id="@+id/toggle_knob"
                android:layout_width="90dp"
                android:layout_height="30dp"
                android:textSize="14sp"
                app:colorBorder="@color/grey"
                app:colorOff="@color/white"
                app:colorOn="@color/light_grey"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:on="false" />

            <TextView
                android:id="@+id/useTextTile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tile Switch"
                android:theme="@style/subheading_text_style"
                app:layout_constraintBottom_toBottomOf="@+id/toggle_iE_tile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/toggle_iE_tile" />

            <com.github.angads25.toggle.widget.LabeledSwitch
                android:id="@+id/toggle_iE_tile"
                android:layout_width="90dp"
                android:layout_height="30dp"
                android:textSize="14sp"
                app:colorBorder="@color/grey"
                app:colorOff="@color/white"
                app:colorOn="@color/light_grey"
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/toggle_knob"
                app:on="false" />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--    color change-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPanelColorChange"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_5sdp"
        android:background="@drawable/background_grey_border_white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/includeButtonLoudness"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/focusLayoutColorChange"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/background_transparent_border_yellow"
            android:translationZ="@dimen/_1sdp"
            tools:ignore="MissingConstraints" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.32025125" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.75" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:fontFamily="@font/avenir_next_lt_pro_medium"
            android:text="Graph Name"
            android:textAllCaps="true"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="@id/preessure"
            app:layout_constraintStart_toStartOf="@id/preessure"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/graphColortitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:fontFamily="@font/avenir_next_lt_pro_medium"
            android:text="Patient trigger Color"
            android:textAllCaps="true"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="@id/pressureLayout"
            app:layout_constraintStart_toStartOf="@id/pressureLayout"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/preessure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="PRESSURE WAVE"
            android:theme="@style/subheading_text_style"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pressureLayout"
            android:layout_width="200dp"
            android:layout_height="@dimen/_14sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/background_offwhite_border_none"
            app:layout_constraintBottom_toBottomOf="@id/preessure"
            app:layout_constraintStart_toEndOf="@id/guideline"
            app:layout_constraintTop_toTopOf="@id/preessure" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cbLayoutPressure"
            android:layout_width="@dimen/_9sdp"
            android:layout_height="@dimen/_9sdp"
            android:layout_marginStart="@dimen/_2sdp"
            app:layout_constraintBottom_toBottomOf="@id/pressureLayout"
            app:layout_constraintStart_toStartOf="@id/pressureLayout"
            app:layout_constraintTop_toTopOf="@id/pressureLayout" />

        <TextView
            android:id="@+id/pressureText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            android:fontFamily="@font/arial_regular"
            android:textColor="@color/black"
            android:textSize="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="@id/pressureLayout"
            app:layout_constraintEnd_toEndOf="@id/pressureLayout"
            app:layout_constraintStart_toEndOf="@id/cbLayoutPressure"
            app:layout_constraintTop_toTopOf="@id/pressureLayout"
            tools:text="WHEAT" />

        <TextView
            android:id="@+id/volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="VOLUME WAVE"
            android:theme="@style/subheading_text_style"
            app:layout_constraintStart_toStartOf="@id/preessure"
            app:layout_constraintTop_toBottomOf="@id/preessure" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/volumeLayout"
            android:layout_width="200dp"
            android:layout_height="@dimen/_14sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/background_offwhite_border_none"
            app:layout_constraintBottom_toBottomOf="@id/volume"
            app:layout_constraintStart_toEndOf="@id/guideline"
            app:layout_constraintTop_toTopOf="@id/volume" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cbLayoutVolume"
            android:layout_width="@dimen/_9sdp"
            android:layout_height="@dimen/_9sdp"
            android:layout_marginStart="@dimen/_2sdp"
            app:layout_constraintBottom_toBottomOf="@id/volumeLayout"
            app:layout_constraintStart_toStartOf="@id/volumeLayout"
            app:layout_constraintTop_toTopOf="@id/volumeLayout" />

        <TextView
            android:id="@+id/volumeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            android:fontFamily="@font/arial_regular"
            android:textColor="@color/black"
            android:textSize="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="@id/volumeLayout"
            app:layout_constraintEnd_toEndOf="@id/volumeLayout"
            app:layout_constraintStart_toEndOf="@id/cbLayoutVolume"
            app:layout_constraintTop_toTopOf="@id/volumeLayout"
            tools:text="WHEAT" />


        <TextView
            android:id="@+id/flow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15sdp"
            android:text="FLOW WAVE"
            android:theme="@style/subheading_text_style"
            app:layout_constraintStart_toStartOf="@id/preessure"
            app:layout_constraintTop_toBottomOf="@id/volume" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/flowLayout"
            android:layout_width="200dp"
            android:layout_height="@dimen/_14sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/background_offwhite_border_none"
            app:layout_constraintBottom_toBottomOf="@id/flow"
            app:layout_constraintStart_toEndOf="@id/guideline"
            app:layout_constraintTop_toTopOf="@id/flow" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cbLayoutFlow"
            android:layout_width="@dimen/_9sdp"
            android:layout_height="@dimen/_9sdp"
            android:layout_marginStart="@dimen/_2sdp"
            app:layout_constraintBottom_toBottomOf="@id/flowLayout"
            app:layout_constraintStart_toStartOf="@id/flowLayout"
            app:layout_constraintTop_toTopOf="@id/flowLayout" />

        <TextView
            android:id="@+id/flowText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            android:fontFamily="@font/arial_regular"
            android:textColor="@color/black"
            android:textSize="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="@id/flowLayout"
            app:layout_constraintEnd_toEndOf="@id/flowLayout"
            app:layout_constraintStart_toEndOf="@id/cbLayoutFlow"
            app:layout_constraintTop_toTopOf="@id/flowLayout"
            tools:text="WHEAT" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/colorRecyclerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:ignore="MissingConstraints" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--Day & Night View-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPanelDayNight"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_5sdp"
        android:background="@drawable/background_dark_grey"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/includeButtonLoudness"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/progressBarBrightness"
            layout="@layout/content_circular_progress_bar_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_40sdp"
            app:layout_constraintBottom_toTopOf="@+id/textViewBrightness"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewBrightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="@string/hint_brightness"
            android:theme="@style/subheading_text_style"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressBarBrightness" />

        <include
            android:id="@+id/includeButtonDay"
            layout="@layout/content_button_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_80sdp"
            android:layout_marginTop="@dimen/_15sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewBrightness" />

        <include
            android:id="@+id/includeButtonNight"
            layout="@layout/content_button_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_2sdp"
            app:layout_constraintStart_toEndOf="@+id/includeButtonDay"
            app:layout_constraintTop_toBottomOf="@+id/textViewBrightness" />

        <include
            android:id="@+id/includeButtonAutomatic"
            layout="@layout/content_button_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintStart_toEndOf="@+id/includeButtonNight"
            app:layout_constraintTop_toBottomOf="@+id/textViewBrightness" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--Date & Time-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPanelDateTime"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/_5sdp"
        android:background="@drawable/background_grey_border_white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/includeButtonLoudness"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layoutYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@+id/layoutMonth"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <include
                android:id="@+id/progressBarYear"
                layout="@layout/content_circular_progress_bar_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="@string/hint_year"
                android:theme="@style/subheading_text_style" />

        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layoutMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@+id/layoutDay"
            app:layout_constraintStart_toEndOf="@+id/layoutYear"
            app:layout_constraintTop_toTopOf="parent">

            <include
                android:id="@+id/progressBarMonth"
                layout="@layout/content_circular_progress_bar_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="@string/hint_month"
                android:theme="@style/subheading_text_style" />

        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layoutDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@+id/layoutMonth"
            app:layout_constraintTop_toTopOf="parent">

            <include
                android:id="@+id/progressBarDay"
                layout="@layout/content_circular_progress_bar_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="@string/hint_day"
                android:theme="@style/subheading_text_style" />

        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layoutHour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@+id/layoutMinute"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutYear">

            <include
                android:id="@+id/progressBarHour"
                layout="@layout/content_circular_progress_bar_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewHour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="@string/hint_hour"
                android:theme="@style/subheading_text_style" />

        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layoutMinute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@+id/layoutDateTime"
            app:layout_constraintStart_toEndOf="@+id/layoutHour"
            app:layout_constraintTop_toBottomOf="@+id/layoutMonth">

            <include
                android:id="@+id/progressBarMinute"
                layout="@layout/content_circular_progress_bar_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewMinute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="@string/hint_minute"
                android:theme="@style/subheading_text_style" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layoutDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@+id/layoutMinute"
            app:layout_constraintTop_toBottomOf="@+id/layoutDay">


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:text="@string/hint_date"
                android:theme="@style/subheading_text_style" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewDateView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:text="20-11-11"
                android:theme="@style/subheading_text_style" />


