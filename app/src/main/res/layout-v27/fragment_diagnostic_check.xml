            android:text="value1" />

<!--        ranges section-->

        <TextView
            android:id="@+id/txtTurbineRanges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Turbine PWM"
            android:theme="@style/subheading_text_style_diag"
            app:layout_constraintStart_toStartOf="@id/guideline1"
            app:layout_constraintTop_toTopOf="@id/btnTurbineRanges"
            app:layout_constraintBottom_toBottomOf="@id/btnTurbineRanges"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnTurbineRanges"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:background="@drawable/background_light_grey"
            app:layout_constraintStart_toStartOf="@id/guideline2"
            app:layout_constraintTop_toBottomOf="@id/txtKnobPCBVersion">

