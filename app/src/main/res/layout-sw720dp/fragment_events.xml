<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/tvNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5sdp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/uhidLayout"
        app:layout_constraintBottom_toBottomOf="@+id/uhidLayout"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvheading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="@dimen/_5sdp"
            android:text="Note - Please use the rotatory knob to scroll the events"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/uhidLayout"
        android:layout_width="@dimen/_70sdp"
        android:layout_height="@dimen/_15sdp"
        android:visibility="gone"
        android:background="@drawable/custom_edit_text_background"
        android:layout_marginTop="@dimen/_3sdp"
        app:layout_constraintEnd_toEndOf="@id/recyclerViewEvents"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtUhid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UHID : "
            android:textColor="@color/black"
            android:fontFamily="@font/avenir_next_lt_pro_medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/uhidRecyclerView"
        android:layout_width="0dp"
        android:layout_height="@dimen/_70sdp"
        android:visibility="gone"
        android:translationZ="@dimen/_3sdp"
        tools:listitem="@layout/setup_select_layout"
        app:layout_constraintStart_toStartOf="@id/uhidLayout"
        app:layout_constraintEnd_toEndOf="@id/uhidLayout"
        app:layout_constraintTop_toBottomOf="@id/uhidLayout"/>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/staticLayoutEvent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#eeeeee"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_5sdp"
        app:layout_constraintEnd_toStartOf="@id/seekbarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/uhidLayout">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewDateTime"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginLeft="@dimen/_4sdp"
            android:layout_weight="0.2"
            android:gravity="center_vertical"
            android:text="Date"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewTime"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginLeft="@dimen/_4sdp"
            android:layout_weight="0.2"
            android:gravity="center_vertical"
            android:text="Time"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewEventsData"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="0.8"
            android:gravity="center_vertical"
            android:text="Event"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textViewUHID"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginLeft="@dimen/_4sdp"
            android:layout_weight="0.2"
            android:gravity="center_vertical"
            android:text="UHID"
            android:textColor="@color/black"
            android:textStyle="bold" />


    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewEvents"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:visibility="visible"
        android:overScrollMode="never"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/staticLayoutEvent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/seekbarLayout"
        android:scrollbars="vertical" />

    <LinearLayout
        android:id="@+id/seekbarLayout"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:visibility="invisible"
        app:layout_constraintStart_toEndOf="@id/recyclerViewEvents"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/staticLayoutEvent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/topButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_1sdp"
            android:background="@color/white"
            android:rotation="270"
            android:foregroundGravity="center"
            android:src="@drawable/ic_logtable_righticon" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="@dimen/_20sdp"
            android:layout_margin="@dimen/_1sdp"
            android:layout_weight="0.7"
            android:backgroundTint="@android:color/transparent"
            android:progress="1"
            android:visibility="visible"
            android:progressDrawable="@drawable/custom_seekbar"
            android:secondaryProgressTint="@android:color/transparent"
            android:thumb="@drawable/thumb" />

        <ImageButton
            android:id="@+id/bottomButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_1sdp"
            android:rotation="90"
            android:background="@color/white"
            android:foregroundGravity="center"
            android:src="@drawable/ic_logtable_righticon" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

