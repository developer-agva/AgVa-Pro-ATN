<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/mainViewPanelLogs"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/focusLayoutLogs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/background_transparent_border_yellow"
        android:translationZ="@dimen/_1sdp"
        tools:ignore="MissingConstraints" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageViewCrossLogs"
        android:layout_width="@dimen/_15sdp"
        android:layout_height="@dimen/_15sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginVertical="@dimen/_14sdp"
        android:src="@drawable/ic_cross_grey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/includeButtonTrends"
        layout="@layout/content_button_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        app:layout_constraintStart_toStartOf="@+id/logs_nav_container"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/includeButtonEvents"
        layout="@layout/content_button_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5sdp"
        app:layout_constraintBottom_toBottomOf="@id/includeButtonTrends"
        app:layout_constraintStart_toEndOf="@+id/includeButtonTrends"
        app:layout_constraintTop_toTopOf="@id/includeButtonTrends" />

    <include
        android:id="@+id/includeButtonAlarms"
        layout="@layout/content_button_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5sdp"
        app:layout_constraintBottom_toBottomOf="@id/includeButtonTrends"
        app:layout_constraintStart_toEndOf="@+id/includeButtonEvents"
        app:layout_constraintTop_toTopOf="@id/includeButtonTrends" />

    <TextView
        android:id="@+id/tvlogsDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/_130sdp"
        android:text="Date - "
        android:textColor="@color/black"
        android:textSize="@dimen/_7sdp"
        app:layout_constraintBottom_toBottomOf="@id/includeButtonTrends"
        app:layout_constraintStart_toEndOf="@+id/includeButtonAlarms"
        app:layout_constraintTop_toTopOf="@id/includeButtonTrends" />

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/_10sdp"
        android:textColor="@color/black"
        android:textSize="@dimen/_7sdp"
        app:layout_constraintBottom_toBottomOf="@id/includeButtonTrends"
        app:layout_constraintStart_toEndOf="@+id/tvlogsDate"
        app:layout_constraintTop_toTopOf="@id/includeButtonTrends"
        tools:text="12-01-2020" />


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/logs_nav_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/includeButtonTrends" />

</androidx.constraintlayout.widget.ConstraintLayout>