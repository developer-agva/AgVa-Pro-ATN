        android:text="@string/hint_system"
        android:textColor="@color/dim_grey"
        android:textStyle="bold"
        android:theme="@style/subheading_text_style"
        app:layout_constraintBottom_toTopOf="@id/horizontal2"
        app:layout_constraintEnd_toStartOf="@id/vertical0"
