<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/setupLayout"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/setupRecyclerView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:translationZ="@dimen/_5sdp"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/txtSetupHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_15sdp"
        android:textColor="@color/black"
        android:text="Ventilator Setup"
        android:textAllCaps="true"
        android:fontFamily="@font/avenir_next_lt_pro_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/_20sdp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/btnFinishSetup"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@color/preCalib_amber"
        app:layout_constraintBottom_toBottomOf="@id/txtSetupHeading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtSetupHeading" >

        <TextView
            android:id="@+id/txtFinishSetup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_8sdp"
            android:textColor="@color/black"
            android:text="FINISH"
            android:fontFamily="@font/avenir_next_lt_pro_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/setupStartGuideline"
        app:layout_constraintGuide_percent="0.10"
        android:orientation="vertical"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/setupMidGuideline"
        app:layout_constraintGuide_percent="0.35"
        android:orientation="vertical"/>

    <TextView
        android:id="@+id/txtSetupPressureSensor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/black"
        android:text="Pressure Sensor"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        app:layout_constraintStart_toStartOf="@id/setupStartGuideline"
        app:layout_constraintTop_toBottomOf="@id/txtSetupHeading"
        android:layout_marginTop="@dimen/_25sdp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pressureLayoutOne"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_20sdp"
        android:background="@drawable/background_offwhite_border_none"
        app:layout_constraintBottom_toBottomOf="@id/txtSetupPressureSensor"
        app:layout_constraintStart_toEndOf="@id/setupMidGuideline"
        app:layout_constraintTop_toTopOf="@id/txtSetupPressureSensor" >

        <TextView
            android:id="@+id/txtPressureOneValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            android:text="Pressure One"
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/avenir_next_lt_pro_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pressureLayoutTwo"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginStart="@dimen/_20sdp"
        android:background="@drawable/background_offwhite_border_none"
        app:layout_constraintBottom_toBottomOf="@id/txtSetupPressureSensor"
        app:layout_constraintStart_toEndOf="@id/pressureLayoutOne"
        app:layout_constraintTop_toTopOf="@id/txtSetupPressureSensor" >

        <TextView
            android:id="@+id/txtPressureTwoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            android:text="Pressure Two"
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/avenir_next_lt_pro_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pressureLayoutThree"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginStart="@dimen/_20sdp"
        android:background="@drawable/background_offwhite_border_none"
        app:layout_constraintBottom_toBottomOf="@id/txtSetupPressureSensor"
        app:layout_constraintStart_toEndOf="@id/pressureLayoutTwo"
        app:layout_constraintTop_toTopOf="@id/txtSetupPressureSensor" >

        <TextView
            android:id="@+id/txtPressureThreeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            android:text="Pressure Three"
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/avenir_next_lt_pro_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtSetupFlowSensor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/black"
        android:text="Flow Sensor"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        app:layout_constraintStart_toStartOf="@id/setupStartGuideline"
        app:layout_constraintTop_toBottomOf="@id/txtSetupPressureSensor"
        android:layout_marginTop="@dimen/_17sdp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flowLayoutInsp"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_20sdp"
        android:background="@drawable/background_offwhite_border_none"
        app:layout_constraintBottom_toBottomOf="@id/txtSetupFlowSensor"
        app:layout_constraintStart_toEndOf="@id/setupMidGuideline"
        app:layout_constraintTop_toTopOf="@id/txtSetupFlowSensor" >

        <TextView
            android:id="@+id/txtFlowInspValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            android:text="Insp Flow"
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/avenir_next_lt_pro_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/flowLayoutExp"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginStart="@dimen/_20sdp"
        android:background="@drawable/background_offwhite_border_none"
        app:layout_constraintBottom_toBottomOf="@id/txtSetupFlowSensor"
        app:layout_constraintStart_toEndOf="@id/flowLayoutInsp"
        app:layout_constraintTop_toTopOf="@id/txtSetupFlowSensor" >

        <TextView
            android:id="@+id/txtFlowExpValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            android:text="Exp Flow"
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/avenir_next_lt_pro_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtSetupOxygenSensor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/black"
        android:text="Oxygen Sensor"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        app:layout_constraintStart_toStartOf="@id/setupStartGuideline"
        app:layout_constraintTop_toBottomOf="@id/txtSetupFlowSensor"
        android:layout_marginTop="@dimen/_17sdp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/oxygenLayout"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_20sdp"
        android:background="@drawable/background_offwhite_border_none"
        app:layout_constraintBottom_toBottomOf="@id/txtSetupOxygenSensor"
        app:layout_constraintStart_toEndOf="@id/setupMidGuideline"
        app:layout_constraintTop_toTopOf="@id/txtSetupOxygenSensor" >

        <TextView
            android:id="@+id/txtOxygenValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            android:text="Oxygen Sensor "
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/avenir_next_lt_pro_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtNeonateSensor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/black"
        android:text="Neonate Sensor"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        app:layout_constraintStart_toStartOf="@id/setupStartGuideline"
        app:layout_constraintTop_toBottomOf="@id/txtSetupOxygenSensor"
        android:layout_marginTop="@dimen/_17sdp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/neonateSensorLayout"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_20sdp"
        android:background="@drawable/background_offwhite_border_none"
        app:layout_constraintBottom_toBottomOf="@id/txtNeonateSensor"
        app:layout_constraintStart_toEndOf="@id/setupMidGuideline"
        app:layout_constraintTop_toTopOf="@id/txtNeonateSensor" >

        <TextView
            android:id="@+id/txtNeonateSensorValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            android:text="Neonate Sensor "
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/avenir_next_lt_pro_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtSpo2Sensor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/black"
        android:text="Spo2 Sensor"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        app:layout_constraintStart_toStartOf="@id/setupStartGuideline"
        app:layout_constraintTop_toBottomOf="@id/txtNeonateSensor"
        android:layout_marginTop="@dimen/_17sdp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/spo2SensorLayout"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_20sdp"
        android:background="@drawable/background_offwhite_border_none"
        app:layout_constraintBottom_toBottomOf="@id/txtSpo2Sensor"
        app:layout_constraintStart_toEndOf="@id/setupMidGuideline"
        app:layout_constraintTop_toTopOf="@id/txtSpo2Sensor" >

        <TextView
            android:id="@+id/txtSpo2SensorValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            android:text="Spo2 Sensor "
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/avenir_next_lt_pro_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtSetupValve"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/black"
        android:text="Proportional Valve"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        app:layout_constraintStart_toStartOf="@id/setupStartGuideline"
        app:layout_constraintTop_toBottomOf="@id/txtSpo2Sensor"
        android:layout_marginTop="@dimen/_17sdp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/valveLayout"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_20sdp"
        android:background="@drawable/background_offwhite_border_none"
        app:layout_constraintBottom_toBottomOf="@id/txtSetupValve"
        app:layout_constraintStart_toEndOf="@id/setupMidGuideline"
        app:layout_constraintTop_toTopOf="@id/txtSetupValve" >

        <TextView
            android:id="@+id/txtValveValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            android:text="Valve"
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/avenir_next_lt_pro_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtNeoPCBType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/black"
        android:text="Neonate PCB Type"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        app:layout_constraintStart_toStartOf="@id/setupStartGuideline"
        app:layout_constraintTop_toBottomOf="@id/txtSetupValve"
        android:layout_marginTop="@dimen/_17sdp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/neoPcbTypeLayout"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_20sdp"
        android:background="@drawable/background_offwhite_border_none"
        app:layout_constraintBottom_toBottomOf="@id/txtNeoPCBType"
        app:layout_constraintStart_toEndOf="@id/setupMidGuideline"
        app:layout_constraintTop_toTopOf="@id/txtNeoPCBType" >

        <TextView
            android:id="@+id/txtNeoPCBTypeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            android:text="Neo PCB Type"
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/avenir_next_lt_pro_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtNebulizerType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/black"
        android:text="Nebulizer Type"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        app:layout_constraintStart_toStartOf="@id/setupStartGuideline"
        app:layout_constraintTop_toBottomOf="@id/txtNeoPCBType"
        android:layout_marginTop="@dimen/_17sdp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nebulizerTypeLayout"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_20sdp"
        android:background="@drawable/background_offwhite_border_none"
        app:layout_constraintBottom_toBottomOf="@id/txtNebulizerType"
        app:layout_constraintStart_toEndOf="@id/setupMidGuideline"
        app:layout_constraintTop_toTopOf="@id/txtNebulizerType" >

        <TextView
            android:id="@+id/txtNebulizerTypeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            android:text="Neb Type Value"
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/avenir_next_lt_pro_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txtOxygenConcentrator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_10sdp"
        android:textColor="@color/black"
        android:text="Oxygen Concentrator"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        app:layout_constraintStart_toStartOf="@id/setupStartGuideline"
        app:layout_constraintTop_toBottomOf="@id/txtNebulizerType"
        android:layout_marginTop="@dimen/_17sdp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/oxygenConcentratorLayout"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_20sdp"
        android:background="@drawable/background_offwhite_border_none"
        app:layout_constraintBottom_toBottomOf="@id/txtOxygenConcentrator"
        app:layout_constraintStart_toEndOf="@id/setupMidGuideline"
        app:layout_constraintTop_toTopOf="@id/txtOxygenConcentrator" >

        <TextView
            android:id="@+id/txtOxygenConcentratorValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_7sdp"
            android:textColor="@color/black"
            android:textAllCaps="true"
            android:text="NO"
            android:layout_marginBottom="@dimen/_4sdp"
            android:fontFamily="@font/avenir_next_lt_pro_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
