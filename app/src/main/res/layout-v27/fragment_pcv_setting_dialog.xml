<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/background_rounded_graph"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_3sdp"
                android:text="@string/hint_setting_of_pcv"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:theme="@style/subheading_text_style" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageViewCross"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center"
                    android:padding="@dimen/_1sdp"
                    android:src="@drawable/ic_cross"
                    />



            </FrameLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>


        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_2sdp"
            android:background="@color/white">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="652dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_5sdp"
                android:padding="@dimen/_4sdp"
                app:srcCompat="@drawable/graphical_tooltip_new" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ieRatioBack"
                android:layout_width="175dp"
                android:layout_height="27dp"
                android:layout_gravity="top|right"
                android:layout_marginRight="3dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/rectangle" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewTtot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/_35sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:text="@string/titot"
                android:theme="@style/subheading_text_style_graph_mini" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewTinsp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_25sdp"
                android:layout_marginTop="@dimen/_19sdp"
                android:text="@string/inhale_time"
                android:theme="@style/subheading_text_style_graph_mini" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewTexp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right|top"
                android:layout_marginTop="@dimen/_19sdp"
                android:layout_marginEnd="@dimen/_57sdp"
                android:text="@string/inhale_time"
                android:theme="@style/subheading_text_style_graph_mini" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewPi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|right"
                android:layout_marginRight="@dimen/_6sdp"
                android:layout_marginTop="78dp"
                android:text="@string/ps"
                android:textAllCaps="true"
                android:theme="@style/subheading_text_style_graph_mini" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewPeepPi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right|center"
                android:layout_marginRight="@dimen/_10sdp"
                android:text="@string/pi"
                android:theme="@style/subheading_text_style_graph_mini" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewPeepPiSign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|top"
                android:layout_marginTop="@dimen/_11sdp"
                android:layout_marginRight="@dimen/_20sdp"
                android:visibility="gone"
                android:text="@string/pinsp"
                android:textAllCaps="true"
                android:theme="@style/subheading_text_style_graph_mini" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewIERatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|right"
                android:layout_marginRight="18dp"
                android:layout_marginTop="33dp"
                android:text="@string/ieratio"
                android:textAllCaps="true"
                android:theme="@style/subheading_text_style_graph_mini" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_spontaneous_breathe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|right"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:text="@string/spontaneous_breathe"
                android:textAllCaps="true"
                android:theme="@style/subheading_text_style_graph_mini" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_control_breathe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|right"
                android:layout_marginRight="@dimen/_55sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:text="@string/control_breathe"
                android:textAllCaps="true"
                android:theme="@style/subheading_text_style_graph_mini" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textViewTrigERatio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right|center"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_marginTop="44dp"
                android:text="@string/trig_exp"
                android:textAllCaps="true"
                android:theme="@style/subheading_text_style_graph_mini" />

        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>


</androidx.appcompat.widget.LinearLayoutCompat>