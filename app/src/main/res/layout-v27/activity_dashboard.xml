        android:background="@color/black"
        android:text="@string/hint_controls"
        android:textColor="@color/dim_grey"
        android:textStyle="bold"
        android:theme="@style/subheading_text_style"
        app:layout_constraintBottom_toTopOf="@id/button_systems"
        app:layout_constraintEnd_toStartOf="@id/vertical0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_modes" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_systems"
        android:layout_width="0dp"
        android:layout_height="0dp"
