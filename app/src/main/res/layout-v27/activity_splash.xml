<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/mainLayout"
    tools:context="com.agvahealthcare.ventilator_ext.SplashActivity">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.94"
        android:orientation="horizontal"
        android:id="@+id/connectionGuideLine"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:visibility="visible"
        android:id="@+id/splashMainLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="@dimen/_330sdp"
            android:layout_height="@dimen/_220sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/layoutPanelSplash"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageViewAgVaHealthcare"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.99"
            app:srcCompat="@mipmap/ic_icon" />


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layoutPanelAgVaPro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_agvac"
                android:layout_marginEnd="@dimen/_2sdp"
                android:textColor="@color/colorAccent"
                android:visibility="visible"
                android:textSize="@dimen/_30sdp"
                android:theme="@style/subheading_text_style" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_3sdp"
                android:text="@string/hint_pro"
                android:textAllCaps="true"
                android:textColor="@color/colorAccentPro"
                android:textSize="@dimen/_30sdp"
                android:theme="@style/subheading_text_style" />




        </androidx.appcompat.widget.LinearLayoutCompat>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/layoutPanelAgVaPro"

            app:layout_constraintEnd_toEndOf="@id/layoutPanelAgVaPro"
            android:layout_marginTop="@dimen/_5sdp"
            >



        </LinearLayout>


        <LinearLayout
            android:id="@+id/layoutVentiSwitchOff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@+id/layoutPanelAgVaPro"
            app:layout_constraintStart_toStartOf="@+id/layoutPanelAgVaPro"
            app:layout_constraintTop_toBottomOf="@+id/layoutPanelAgVaPro">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VENTILATOR IS SWITCHED OFF"
                android:textAllCaps="true"
                android:textColor="@color/colorAccent"
                android:textSize="20dp"
                android:theme="@style/subheading_text_style"
                android:visibility="visible" />


            <TextView
                android:id="@+id/tvSwitchOffMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:padding="6dp"
                android:text="@string/press_switch_onn_manually"
                android:textAlignment="center"
                android:textColor="#BE504F4F"
                android:textSize="16dp"
                android:theme="@style/subheading_text_style" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutPanelAgVaPro">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/PROG"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:trackColor="@color/colorAccent"
                android:indeterminate="true"
                app:indicatorColor="@color/dark_grey"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminate="false"
                android:indeterminateTint="@color/colorAccent"
                android:scaleY="1.3"
                android:visibility="gone" />


            <TextView
                android:id="@+id/tvUpdateMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textAllCaps="true"
                android:padding="6dp"
                android:text="Ventilator Initiating"
                android:textAlignment="center"
                android:textColor="#BE504F4F"
                android:textSize="20dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutProgressCalib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_40sdp"
            android:orientation="horizontal"
            android:visibility="visible"
            android:layout_marginEnd="@dimen/_10sdp"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutProgress">
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/progresscircle_red"
                android:indeterminateDuration="2000"
                />


            <!--        <com.google.android.material.progressindicator.LinearProgressIndicator-->
            <!--            android:id="@+id/calib_progress"-->
            <!--            android:layout_width="260dp"-->
            <!--            android:layout_height="wrap_content"-->
            <!--            android:layout_margin="12dp"-->
            <!--            app:trackColor="@color/colorAccent"-->
            <!--            android:indeterminate="true"-->
            <!--            app:indicatorColor="@color/dark_grey"-->
            <!--            app:layout_constraintLeft_toLeftOf="parent"-->
            <!--            app:layout_constraintRight_toRightOf="parent"-->
            <!--            app:layout_constraintTop_toTopOf="parent" />-->

            <ProgressBar
                android:id="@+id/calib_progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminate="false"
                android:indeterminateTint="@color/colorAccent"
                android:scaleY="1.3"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_calib_UpdateMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_5sdp"
                android:gravity="center"
                android:textAllCaps="true"
                android:padding="6dp"
                android:text="Pre-ventilation startup check in progress"
                android:textAlignment="center"
                android:textColor="#BE504F4F"
                android:textSize="20dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutProgressCalib1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/_10sdp"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutProgressCalib">



            <!--        <com.google.android.material.progressindicator.LinearProgressIndicator-->
            <!--            android:id="@+id/calib_progress"-->
            <!--            android:layout_width="260dp"-->
            <!--            android:layout_height="wrap_content"-->
            <!--            android:layout_margin="12dp"-->
            <!--            app:trackColor="@color/colorAccent"-->
            <!--            android:indeterminate="true"-->
            <!--            app:indicatorColor="@color/dark_grey"-->
            <!--            app:layout_constraintLeft_toLeftOf="parent"-->
            <!--            app:layout_constraintRight_toRightOf="parent"-->
            <!--            app:layout_constraintTop_toTopOf="parent" />-->

            <ProgressBar
                android:id="@+id/calib_progressBar1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminate="false"
                android:indeterminateTint="@color/colorAccent"
                android:scaleY="1.3"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_calib_UpdateMsg1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_5sdp"
                android:gravity="center"
                android:textAllCaps="true"
                android:padding="6dp"
                android:text="Pre-ventilation startup check in progress"
                android:textAlignment="center"
                android:textColor="#BE504F4F"
                android:textSize="17dp" />

        </LinearLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layoutService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/verlayoutPanel"
            android:layout_marginBottom="30dp"
            android:weightSum="1.99">
            <TextView
                android:id="@+id/tvtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_7sdp"
                android:layout_weight="0.2"
                android:layout_gravity="center"
                android:gravity="center"
                android:textStyle="bold"
                android:text="Facing issue in ventilator, raise service request"
                android:fontFamily="@font/avenir_next_lt_pro_medium"/>
            <Button
                android:id="@+id/btnService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Raise service request"
                android:layout_weight="0.09"
                android:textColor="@color/black"
                android:layout_marginEnd="50dp"
                android:backgroundTint="@color/preCalib_amber" />


        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/verlayoutPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.99">


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCopyright"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/hint_copyright"
                android:textColor="#BE504F4F"
                android:textSize="@dimen/_5sdp" />


        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:fontFamily="@font/poppins_medium"
            android:text="Version aplha 1.0.1"
            android:textColor="#BE504F4F"
            android:textSize="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.99" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone"
        android:id="@+id/dashsplashSecondaryLayout"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/connectionLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/connectionGuideLine">


        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/cvHideConnection"
            android:layout_width="@dimen/_5sdp"
            android:layout_height="@dimen/_5sdp"
            android:src="@color/red"
            android:layout_marginHorizontal="@dimen/_7sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cvVentilatorConnection"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>


        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/cvVentilatorConnection"
            android:layout_width="@dimen/_5sdp"
            android:layout_height="@dimen/_5sdp"
            android:src="@color/red"
            android:layout_marginHorizontal="@dimen/_7sdp"
            app:layout_constraintStart_toEndOf="@id/cvHideConnection"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>