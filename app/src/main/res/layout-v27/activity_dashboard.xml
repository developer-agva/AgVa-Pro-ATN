        <RelativeLayout
            android:id="@+id/leftSideObsList"
            android:layout_width="@dimen/_11sdp"
            android:layout_height="0dp"
            android:background="@drawable/background_grey_left_radious"
            app:layout_constraintBottom_toBottomOf="@+id/mainObservedList"
            app:layout_constraintEnd_toStartOf="@+id/mainObservedList"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/mainObservedList">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/comonasd"
                android:layout_width="@dimen/_11sdp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivParamMenuCross"
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="@dimen/_8sdp"
                    android:layout_gravity="center"
                    android:alpha="0.65"
                    android:padding="@dimen/_1sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_cross"
                    app:tint="@color/grey_dark" />

                <View
                    android:id="@+id/asdaw"
                    android:layout_width="match_parent"
                    android:layout_height="1.4dp"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:layout_marginBottom="@dimen/_1sdp"
                    android:alpha="0.45"
                    android:background="@color/grey_dark" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivSwappableUp"
                    android:layout_width="@dimen/_7sdp"
                    android:layout_height="@dimen/_7sdp"
