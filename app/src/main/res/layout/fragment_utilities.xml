<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainViewPanelUtilities"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_grey_border_white">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/focusLayoutUtilities"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/background_transparent_border_yellow"
        android:translationZ="@dimen/_1sdp"
        tools:ignore="MissingConstraints" />


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/utilitiesHorizontal1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.35" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/title_Nebuliser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hint_nebulizer"
        android:theme="@style/subheading_text_style"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/utilitiesHorizontal1" />

    <include
        android:id="@+id/progress_nebuliser"
        layout="@layout/knob_progress_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_Nebuliser" />

    <TextView
        android:id="@+id/tvminute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:text="minute"
        app:layout_constraintEnd_toEndOf="@id/progress_nebuliser"
        app:layout_constraintStart_toStartOf="@id/progress_nebuliser"
        app:layout_constraintTop_toBottomOf="@id/progress_nebuliser" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNebulizationsttart"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/background_light_grey"
        android:padding="5dp"
        android:text="Start Nebulization"
        android:textAllCaps="true"
        android:textColor="@color/black"
        android:theme="@style/button_normal_style"
        app:layout_constraintEnd_toEndOf="@id/tvminute"
        app:layout_constraintStart_toStartOf="@id/tvminute"
        app:layout_constraintTop_toBottomOf="@id/tvminute" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNebulizationend"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/background_light_grey"
        android:padding="5dp"
        android:text="Stop Nebulization"
        android:textAllCaps="true"
        android:textColor="@color/black"
        android:theme="@style/button_normal_style"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/tvminute"
        app:layout_constraintStart_toStartOf="@id/tvminute"
        app:layout_constraintTop_toBottomOf="@id/tvminute" />


</androidx.constraintlayout.widget.ConstraintLayout>