<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="MissingDefaultResource">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenterVertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.33"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineEndVertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.65"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTopHorizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.10"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenterHorizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.18"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenterBottomHorizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.26"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineBottomHorizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintGuide_percent="0.34"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/preCalib_amber"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="System Configuration"
            android:fontFamily="@font/avenir_next_lt_pro_medium"
            android:textColor="@color/black"
            android:textSize="@dimen/_10sdp"
            android:gravity="center"
            android:layout_gravity="center|center_vertical"
            />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCurrentIP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current IP address"
        android:textSize="@dimen/_6sdp"
        android:textColor="@color/black"
        android:fontFamily="@font/avenir_next_lt_pro_bold"
        android:layout_marginStart="@dimen/_5sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guidelineTopHorizontal"
        app:layout_constraintBottom_toTopOf="@id/guidelineCenterHorizontal"/>

    <TextView
        android:id="@+id/tvCurrentIPValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        android:textSize="@dimen/_6sdp"
        android:textColor="@color/black"
        android:text="Current IP address"
        app:layout_constraintStart_toStartOf="@id/guidelineCenterVertical"
        app:layout_constraintTop_toBottomOf="@id/guidelineTopHorizontal"
        app:layout_constraintBottom_toTopOf="@id/guidelineCenterHorizontal"/>

    <TextView
        android:id="@+id/tvNewIP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New IP address - "
        android:textSize="@dimen/_6sdp"
        android:textColor="@color/black"
        android:fontFamily="@font/avenir_next_lt_pro_bold"
        app:layout_constraintStart_toStartOf="@id/tvCurrentIP"
        app:layout_constraintTop_toBottomOf="@id/guidelineCenterHorizontal"
        app:layout_constraintBottom_toTopOf="@id/guidelineCenterBottomHorizontal"/>

    <EditText
        android:id="@+id/etNewIPValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter new IP address"
        android:textColorHint="@color/black"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@id/guidelineCenterVertical"
        app:layout_constraintEnd_toEndOf="@id/tvCurrentIPValue"
        app:layout_constraintTop_toBottomOf="@id/guidelineCenterHorizontal"
        app:layout_constraintBottom_toTopOf="@id/guidelineCenterBottomHorizontal"/>

    <Button
        android:id="@+id/btnAssignIP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="assign IP"
        android:backgroundTint="@color/racing_green"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@id/guidelineEndVertical"
        app:layout_constraintTop_toTopOf="@id/guidelineCenterHorizontal"
        app:layout_constraintBottom_toBottomOf="@id/guidelineCenterBottomHorizontal"/>

    <TextView
        android:id="@+id/tvClearOpHours"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset Ventilator Data"
        android:textSize="@dimen/_6sdp"
        android:textColor="@color/black"
        android:fontFamily="@font/avenir_next_lt_pro_bold"
        app:layout_constraintStart_toStartOf="@id/tvNewIP"
        app:layout_constraintTop_toBottomOf="@id/guidelineCenterBottomHorizontal"
        app:layout_constraintBottom_toTopOf="@id/guidelineBottomHorizontal"/>

    <Button
        android:id="@+id/btnResetVenti"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Dispatch"
        android:backgroundTint="@color/racing_green"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@id/etNewIPValue"
        app:layout_constraintTop_toTopOf="@id/guidelineCenterBottomHorizontal"
        app:layout_constraintBottom_toBottomOf="@id/guidelineBottomHorizontal"/>

    <Button
        android:id="@+id/btnClearHours"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset Hours"
        android:backgroundTint="@color/racing_green"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@id/btnAssignIP"
        app:layout_constraintTop_toTopOf="@id/guidelineCenterBottomHorizontal"
        app:layout_constraintBottom_toBottomOf="@id/guidelineBottomHorizontal"/>

    <View
        android:id="@+id/windowSeparator"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_2sdp"
        android:background="@color/uhid_grey"
        android:layout_marginTop="@dimen/_15sdp"
        app:layout_constraintTop_toBottomOf="@id/guidelineBottomHorizontal"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvUpdatedTime"
        android:layout_width="1dp"
        android:layout_height="16dp"
        android:layout_marginTop="@dimen/_4sdp"
        android:text=""
        android:textColor="@color/black"
        android:textSize="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="@id/settingsData"
        app:layout_constraintStart_toStartOf="@id/settingsData"
        app:layout_constraintTop_toBottomOf="@id/windowSeparator" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/settingsData"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tvUpdatedTime"
        app:layout_constraintBottom_toTopOf="@id/txtKnobTitle"
        android:layout_marginVertical="@dimen/_5sdp"
        android:layout_marginHorizontal="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>


    <TextView
        android:id="@+id/txtKnobTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/settingsData"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textColor="@color/black"
        android:textSize="@dimen/_6sdp"
        android:translationZ="@dimen/_1sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:text="Knob Data : "
        android:fontFamily="@font/arial_bold"/>

    <TextView
        android:id="@+id/txtKnobValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/txtKnobTitle"
        app:layout_constraintTop_toTopOf="@id/txtKnobTitle"
        app:layout_constraintBottom_toBottomOf="@id/txtKnobTitle"
        android:textColor="@color/black"
        android:textSize="@dimen/_6sdp"
        android:translationZ="@dimen/_1sdp"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_2sdp"
        android:fontFamily="@font/arial_regular"/>

    <TextView
        android:id="@+id/txtKnobDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5sdp"
        app:layout_constraintStart_toEndOf="@id/txtKnobValue"
        app:layout_constraintTop_toTopOf="@id/txtKnobValue"
        app:layout_constraintBottom_toBottomOf="@id/txtKnobValue"
        android:textColor="@color/black"
        android:textSize="@dimen/_6sdp"
        android:translationZ="@dimen/_1sdp"
        android:layout_marginTop="@dimen/_1sdp"
        android:fontFamily="@font/arial_regular"/>

</androidx.constraintlayout.widget.ConstraintLayout>
