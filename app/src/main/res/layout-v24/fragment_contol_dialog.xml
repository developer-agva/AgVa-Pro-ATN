<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainViewPanelControls"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_grey">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/focusLayoutControls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/background_transparent_border_yellow"
        android:translationZ="@dimen/_1sdp"
        tools:ignore="MissingConstraints" />


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageViewCrossControls"
        android:layout_width="@dimen/_15sdp"
        android:layout_height="@dimen/_15sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:src="@drawable/ic_cross_grey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/control_nav_container" />


    <include
        android:id="@+id/includeButtonBasic"
        layout="@layout/content_button_layout"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="@+id/imageViewCrossControls"
        app:layout_constraintTop_toBottomOf="@+id/imageViewCrossControls" />

    <include
        android:id="@+id/includeButtonAdvance"
        layout="@layout/content_button_layout"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="@+id/imageViewCrossControls"
        app:layout_constraintTop_toBottomOf="@+id/includeButtonBasic" />

    <include
        android:id="@+id/includeButtonApnea"
        layout="@layout/content_button_layout"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="@+id/imageViewCrossControls"
        app:layout_constraintTop_toBottomOf="@+id/includeButtonAdvance" />

    <include
        android:id="@+id/includeButtonsmartFiO2"
        layout="@layout/content_button_layout"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="@+id/imageViewCrossControls"
        app:layout_constraintTop_toBottomOf="@+id/includeButtonApnea" />

    <include
        android:id="@+id/includeButtonVTas"
        layout="@layout/content_button_layout"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="@+id/imageViewCrossControls"
        app:layout_constraintTop_toBottomOf="@+id/includeButtonsmartFiO2" />

    <include
        android:id="@+id/includeButtonEtCuff"
        layout="@layout/content_button_layout"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="@+id/imageViewCrossControls"
        app:layout_constraintTop_toBottomOf="@+id/includeButtonVTas" />


    <include
        android:id="@+id/includeButtonPatient"
        layout="@layout/content_button_layout"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="@+id/imageViewCrossControls"
        app:layout_constraintTop_toBottomOf="@+id/includeButtonEtCuff" />


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/control_nav_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_33sdp"
        android:background="@drawable/background_light_grey_border_grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/includeButtonBasic"
        app:layout_constraintHorizontal_bias="0.472"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />


</androidx.constraintlayout.widget.ConstraintLayout>