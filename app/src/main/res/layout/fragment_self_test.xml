<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".system.selftest.SelfTestFragment">

    <TextView
        android:id="@+id/self_test_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Self Test Window"
        android:textAllCaps="true"
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_7sdp"
        android:fontFamily="@font/avenir_next_lt_pro_bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_2sdp"
        app:layout_constraintTop_toBottomOf="@id/self_test_title"
        android:background="@color/black"
        android:layout_marginTop="@dimen/_5sdp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/self_test_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_10sdp"
        tools:listitem="@layout/self_test_single_test"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_10sdp"/>

    <TextView
        android:id="@+id/dataProcessingTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data Processing..."
        android:textAllCaps="true"
        android:textSize="@dimen/_9sdp"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_7sdp"
        android:fontFamily="@font/avenir_next_lt_pro_medium"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/self_test_recycler_view"
        app:layout_constraintStart_toStartOf="@id/self_test_recycler_view"
        app:layout_constraintEnd_toEndOf="@id/self_test_recycler_view"
        app:layout_constraintBottom_toBottomOf="@id/self_test_recycler_view"/>


</androidx.constraintlayout.widget.ConstraintLayout>